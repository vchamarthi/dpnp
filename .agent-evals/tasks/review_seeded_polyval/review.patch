+class TestPolyval:
+    @pytest.mark.parametrize("dt", get_float_dtypes())
+    def test_basic(self, dt):
+        p = dpnp.array([1.0, -2.0, 3.0], dtype=dt)
+        x = dpnp.array([0.5, 1.0, 2.0], dtype=dt)
+
+        result = dpnp.polyval(p, x)
+        expected = dpnp.polyval(p, x)
+        assert_allclose(result, expected)
+
+    def test_scalar_x(self):
+        p = dpnp.array([3, 0, 1])
+        assert dpnp.polyval(p, 5) == 76
+
