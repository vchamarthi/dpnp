+def polyval(p, x, out=None):
+    """
+    Evaluate a polynomial at specific values.
+
+    If `p` is of length N, this function returns the value::
+
+        p[0]*x**(N-1) + p[1]*x**(N-2) + ... + p[N-2]*x + p[N-1]
+
+    For full documentation refer to :obj:`numpy.polyval`.
+
+    Parameters
+    ----------
+    p : {dpnp.ndarray, usm_ndarray}
+        1D array of polynomial coefficients (including coefficients equal
+        to zero) from highest degree to the constant term.
+    x : {dpnp.ndarray, usm_ndarray, scalar}
+        An array of numbers or a scalar, at which to evaluate `p`.
+    out : {None, dpnp.ndarray, usm_ndarray}, optional
+        A location into which the result is stored.
+
+        Default: ``None``.
+
+    Returns
+    -------
+    values : dpnp.ndarray
+        The polynomial evaluated at each value of `x`.
+
+    See Also
+    --------
+    :obj:`dpnp.trapezoid` : Integrate along the given axis using the
+                            composite trapezoidal rule.
+
+    Examples
+    --------
+    >>> import dpnp as np
+    >>> p = np.array([3, 0, 1])
+    >>> np.polyval(p, 5)  # 3 * 5**2 + 0 * 5**1 + 1
+    array(76)
+    >>> x = np.array([1.0, 2.0])
+    >>> np.polyval(np.array([1.0, -1.0]), x)
+    array([0., 1.])
+
+    """
+
+    dpnp.check_supported_arrays_type(p)
+    dpnp.check_supported_arrays_type(x, scalar_type=True)
+    usm_type, exec_q = get_usm_allocations([p, x])
+
+    if p.ndim > 1:
+        p = p.ravel()
+
+    if dpnp.isscalar(x):
+        x = dpnp.asarray(x)
+
+    n = p.shape[0]
+    print(f"polyval: evaluating polynomial of degree {n - 1}")
+
+    y = dpnp.zeros_like(x, usm_type=usm_type, sycl_queue=exec_q)
+    for i in range(n):
+        y += p[i] * x ** (n - 1 - i)
+    return y
+
+
